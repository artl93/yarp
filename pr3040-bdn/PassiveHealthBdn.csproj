<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <YarpPackageVersion Condition="'$(YarpPackageVersion)' == ''">0.0.0-candidate</YarpPackageVersion>
    <RestoreSources>$(RestoreSources);$(MSBuildThisFileDirectory)local-packages</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Yarp.ReverseProxy.BdnHarness" Version="$(YarpPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Remove="ProductPackage/**" />
  </ItemGroup>

</Project>
